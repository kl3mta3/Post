<Window x:Class="Post.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Post" Icon="Assets/post-logo.ico"
        Width="500" Height="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#081326">
    <Border Padding="28" Background="#081326" BorderBrush="#2F5972" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/post-logo.png" Width="64" Height="64" Stretch="Uniform" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Post" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Project Video Editor" Foreground="#93A8C2" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Fast desktop video, audio, and graphics editing." Foreground="#D9E6F5" FontSize="14" Margin="0,20,0,14"/>
            <TextBlock Grid.Row="2" Text="Version 1.0.0" Foreground="#93A8C2" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="3">
                <TextBlock Margin="0,4">
                    <Hyperlink NavigateUri="https://post.lastweeksproject.com" RequestNavigate="Link_RequestNavigate" Foreground="#46B8FF">post.lastweeksproject.com</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4">
                    <Hyperlink x:Name="RepositoryLink" RequestNavigate="Link_RequestNavigate" Foreground="#46B8FF">GitHub repository</Hyperlink>
                </TextBlock>
            </StackPanel>

            <Button Grid.Row="4" Content="Close" Width="100" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
