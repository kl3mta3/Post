<Window x:Class="Post.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xcad="https://github.com/Dirkster99/AvalonDock" xmlns:xcadTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013" Title="Post - Easy Video Editing" Icon="Assets/post-logo.ico" Width="1400" Height="900" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <ControlTemplate x:Key="EmptyRepeatButton" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
        <Style x:Key="TimelineSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Template="{StaticResource EmptyRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Template="{StaticResource EmptyRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent" Width="14" Margin="-7,-3">
                                                    <Rectangle Fill="#F34B68" Width="2" HorizontalAlignment="Center"/>
                                                    <Rectangle Fill="#F34B68" Width="12" Height="12" VerticalAlignment="Top"/>
                                                    <Rectangle Fill="#F34B68" Width="12" Height="12" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesktopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DesktopMenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#AFC1D8" Margin="28,0,8,0" VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#AFC1D8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PopupAnimation="Fade">
                                <Border Background="#0E172A" BorderBrush="#38506F" BorderThickness="1" CornerRadius="4" Padding="3" MinWidth="210">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsCheckable" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A3654"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#46B8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#091224" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Menu Background="#0A1326" Foreground="White" Padding="5,0" ItemContainerStyle="{StaticResource DesktopMenuItemStyle}" Margin="67,10,37,0">
                    <MenuItem Header="File" RenderTransformOrigin="0.5,0.5">
                        <MenuItem.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="2"/>
                            </TransformGroup>
                        </MenuItem.RenderTransform>
                        <MenuItem Header="New Project" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                        <MenuItem Header="Open Project…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                        <MenuItem Header="Open File…" Click="Open_Click" ToolTip="Add media to this project — the same as ＋ in the Media panel"/>
                        <MenuItem x:Name="RecentProjectsMenu" Header="Recent Projects" SubmenuOpened="RecentProjectsMenu_SubmenuOpened"/>
                        <Separator/>
                        <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                        <MenuItem Header="Save As…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
                        <MenuItem Header="Package Project…" Click="PackageProject_Click" ToolTip="Copy every file this project uses into a folder beside it, so the whole thing can be moved or handed on"/>
                        <Separator/>
                        <MenuItem Header="Export Video…" InputGestureText="Enter" Click="Export_Click"/>
                        <MenuItem Header="Export Audio…" Click="ExportAudio_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Edit" RenderTransformOrigin="0.5,0.5">
                        <MenuItem.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="2"/>
                            </TransformGroup>
                        </MenuItem.RenderTransform>
                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                        <MenuItem Header="Redo" InputGestureText="Ctrl+Shift+Z" Click="Redo_Click"/>
                        <Separator/>
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                        <MenuItem Header="Delete" InputGestureText="Delete" Click="Delete_Click"/>
                        <Separator/>
                        <MenuItem Header="Select">
                            <MenuItem Header="Everything" InputGestureText="Ctrl+A" Click="SelectEverything_Click"/>
                            <Separator/>
                            <MenuItem Header="All video clips" Click="SelectVideo_Click"/>
                            <MenuItem Header="All audio clips" Click="SelectAudio_Click"/>
                            <MenuItem Header="All graphics and text" Click="SelectGraphics_Click"/>
                            <Separator/>
                            <MenuItem Header="Nothing" Click="SelectNothing_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Split Clip" InputGestureText="C" Click="SplitPlacement_Click"/>
                        <MenuItem Header="Screenshot" InputGestureText="P" Click="Snapshot_Click"/>
                    </MenuItem>
                    <MenuItem Header="View" RenderTransformOrigin="0.5,0.5">
                        <MenuItem.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="2"/>
                            </TransformGroup>
                        </MenuItem.RenderTransform>
                        <MenuItem Header="Timeline Zoom">
                            <MenuItem Header="Fit / 100%" Tag="1" Click="TimelineZoom_Click"/>
                            <MenuItem Header="150%" Tag="1.5" Click="TimelineZoom_Click"/>
                            <MenuItem Header="200%" Tag="2" Click="TimelineZoom_Click"/>
                            <MenuItem Header="400%" Tag="4" Click="TimelineZoom_Click"/>
                        </MenuItem>
                        <MenuItem Header="Preview Options">
                            <MenuItem Header="Loop playback" IsCheckable="True" Click="MenuLoop_Click"/>
                            <MenuItem Header="Mute preview" IsCheckable="True" Click="MenuMute_Click"/>
                        </MenuItem>
                        <MenuItem Header="Show / Hide Panels">
                            <MenuItem x:Name="MediaPanelMenuItem" Header="Media panel" IsCheckable="True" IsChecked="True" Click="ToggleMediaPanel_Click"/>
                            <MenuItem x:Name="PreviewPanelMenuItem" Header="Preview panel" IsCheckable="True" IsChecked="True" Click="TogglePreviewPanel_Click"/>
                            <MenuItem x:Name="LayersPanelMenuItem" Header="Layers panel" IsCheckable="True" IsChecked="True" Click="ToggleLayersPanel_Click"/>
                            <Separator/>
                            <MenuItem x:Name="EffectsWindowMenuItem" Header="Effects" InputGestureText="Ctrl+E" IsCheckable="True" Click="ToggleEffectsWindow_Click"/>
                            <MenuItem x:Name="EqualizerWindowMenuItem" Header="Audio EQ" InputGestureText="Ctrl+Q" IsCheckable="True" Click="ToggleEqualizerWindow_Click"/>
                        </MenuItem>
                        <MenuItem Header="Reset Panel Layout" Click="ResetLayout_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="ToolsMenu" Header="Tools">
                        <MenuItem x:Name="WindowsMenu" Header="Windows">
                            <MenuItem x:Name="KeyframesWindowMenuItem" Header="Keyframe Timeline" IsCheckable="True" Click="ToggleKeyframesWindow_Click"/>
                            <MenuItem x:Name="ColorGradingWindowMenuItem" Header="Color Grading" IsCheckable="True" Click="ToggleColorGradingWindow_Click"/>
                            <MenuItem x:Name="AnimationsWindowMenuItem" Header="Animations" IsCheckable="True" Click="ToggleAnimationsWindow_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="SettingsMenu" Header="Settings">
                            <MenuItem Header="Post settings…" InputGestureText="Ctrl+," Click="Settings_Click"/>
                            <MenuItem Header="Export settings…" Click="ExportSettings_Click"/>
                            <Separator/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Plugin Manager…" Click="PluginManager_Click"/>
                    </MenuItem>
                    <MenuItem Header="Help" RenderTransformOrigin="0.5,0.5">
                        <MenuItem.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="2"/>
                            </TransformGroup>
                        </MenuItem.RenderTransform>
                        <MenuItem Header="Check for Updates…" Click="Update_Click"/>
                        <MenuItem Header="About Post" Click="About_Click"/>
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Background="#0A1326" IsHitTestVisible="False" Panel.ZIndex="2">
                    <Image Source="Assets/post-logo.png" Width="34" Height="34" Stretch="Uniform" Margin="0,4,9,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Post" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#0A1326" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ProjectTabBar" Orientation="Horizontal"/>
                </ScrollViewer>
                <Button x:Name="ExportJobsChip" Grid.Column="2" Style="{StaticResource PillButton}" Visibility="Collapsed" Margin="8,0,0,0" Padding="10,4" Click="ExportJobs_Click" ToolTip="Show background exports">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ExportJobsChipIcon" Text="⏳" FontSize="13" Margin="0,0,7,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ExportJobsChipText" Text="Exporting…" FontSize="12" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="ExportJobsChipBar" Width="132" Height="4" Margin="0,3,0,0" Minimum="0" Maximum="1" Background="#0A1526" BorderThickness="0" Foreground="{StaticResource CyanBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <xcad:DockingManager x:Name="Docking" Grid.Row="2" Loaded="Docking_Loaded" Background="{StaticResource BgBrush}" AllowMixedOrientation="True">
            <xcad:DockingManager.Theme>
                <!-- Dock chrome is a lot of surfaces: pane titles, tabs, floating window
                     captions, the dropdown menus on each. The stock theme paints them from
                     system colours, which against this palette came out unreadable, so the
                     whole lot is themed at once rather than a piece at a time. -->
                <xcadTheme:Vs2013DarkTheme/>
            </xcad:DockingManager.Theme>
            <xcad:LayoutRoot>
                <xcad:LayoutPanel Orientation="Vertical">
                    <xcad:LayoutPanel Orientation="Horizontal" DockHeight="*">
                        <xcad:LayoutAnchorablePane DockWidth="280" DockMinWidth="175">
                            <xcad:LayoutAnchorable Title="Media" ContentId="media" CanClose="False" CanHide="True" CanAutoHide="False">
                                <Border CornerRadius="7" BorderBrush="#20314C" BorderThickness="1" Background="#091426">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="#101D33" BorderBrush="#263D5E" BorderThickness="0,0,0,1" Padding="8">
                                            <Grid>
                                                <TextBlock Text="MEDIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <Button Content="＋" HorizontalAlignment="Right" Padding="7,2" Margin="0" Click="Open_Click" ToolTip="Add media"/>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ProjectMediaList" Margin="5"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>
                        <xcad:LayoutAnchorablePane DockWidth="*" DockMinWidth="420">
                            <xcad:LayoutAnchorable Title="Preview" ContentId="preview" CanClose="False" CanHide="True" CanAutoHide="False">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#0A1326" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid Margin="8,5,8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="64" MaxWidth="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="AspectCombo" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedIndex="0" ToolTip="Output shape of the finished video" SelectionChanged="AspectCombo_SelectionChanged">
                                                <ComboBoxItem Content="Original source" Tag="Original"/>
                                                <ComboBoxItem Content="16:9 Landscape" Tag="Landscape16x9"/>
                                                <ComboBoxItem Content="9:16 Vertical / Shorts" Tag="Vertical9x16"/>
                                                <ComboBoxItem Content="1:1 Square" Tag="Square1x1"/>
                                                <ComboBoxItem Content="4:5 Portrait" Tag="Portrait4x5"/>
                                                <ComboBoxItem Content="4:3 Standard" Tag="Standard4x3"/>
                                                <ComboBoxItem Content="21:9 Cinema" Tag="Cinema21x9"/>
                                            </ComboBox>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Zoom/Crop" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <Slider x:Name="CropZoom" Width="110" Minimum="1" Maximum="3" Value="1" TickFrequency=".1" VerticalAlignment="Center" ValueChanged="Crop_ValueChanged"/>
                                                <TextBlock Text="Pan X" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <Slider x:Name="PanX" Width="75" Minimum="-1" Maximum="1" VerticalAlignment="Center" ValueChanged="Crop_ValueChanged"/>
                                                <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <Slider x:Name="PanY" Width="75" Minimum="-1" Maximum="1" VerticalAlignment="Center" ValueChanged="Crop_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="7" BorderBrush="#20314C" BorderThickness="1" Background="#030711" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="66"/>
                                            </Grid.RowDefinitions>
                                            <Grid x:Name="PreviewSurface">
                                                <Grid x:Name="LivePlayerHost" Background="Black" Visibility="Collapsed"/>
                                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
                                                <Grid x:Name="DropPanel" Background="#050918">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="16,0,16,0">
                                                        <Border Width="72" Height="72" CornerRadius="16" BorderBrush="#20405C" BorderThickness="1" Background="#101C31" HorizontalAlignment="Center">
                                                            <TextBlock Text="▦" FontSize="36" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Add files from Media" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,7"/>
                                                        <TextBlock Text="Drag video, audio, or image files here, then place them on Layers." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                        <Button Content="Browse Media Files" Style="{StaticResource AccentButton}" Width="190" Margin="0,16,0,0" Click="Open_Click"/>
                                                    </StackPanel>
                                                    </Viewbox>
                                                </Grid>
                                            </Grid>
                                            <Border Grid.Row="1" BorderBrush="#2F5972" BorderThickness="0,1" Background="#0B2535" ClipToBounds="True" ToolTip="Project seek bar — clips are edited only on Layers">
                                                <ScrollViewer x:Name="SourceTimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TimelineWorkspace_PreviewMouseWheel">
                                                    <Grid x:Name="TimelineArea" MinWidth="600" PreviewMouseLeftButtonDown="Timeline_PreviewMouseLeftButtonDown">
                                                        <Canvas x:Name="WaveformCanvas"/>
                                                        <Rectangle Fill="#153952" Opacity=".25" IsHitTestVisible="False"/>
                                                        <Slider x:Name="Timeline" Style="{StaticResource TimelineSliderStyle}" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" VerticalAlignment="Stretch" Background="Transparent"/>
                                                        <Canvas x:Name="CutOverlay" IsHitTestVisible="False"/>
                                                        <Border x:Name="InHandle" Width="0"/>
                                                        <Border x:Name="OutHandle" Width="0"/>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Border>
                                            <Border Grid.Row="2" Background="#0D1729" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="7">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                                                <Grid Width="1100">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="CurrentText" Text="00:00.000" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                                                        <TextBlock x:Name="DurationText" Text=" / 00:00" Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="|◀" Click="InJump_Click"/>
                                                        <Button Content="−5s" Click="Back5_Click"/>
                                                        <Button Content="‹" Click="FrameBack_Click"/>
                                                        <Button x:Name="PlayButton" Content="▶" FontSize="20" Background="#36A9E1" Width="54" Click="Play_Click"/>
                                                        <Button Content="›" Click="FrameNext_Click"/>
                                                        <Button Content="+5s" Click="Forward5_Click"/>
                                                        <Button Content="▶|" Click="OutJump_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="MuteButton" Content="🔊" Click="Mute_Click"/>
                                                        <Slider x:Name="PreviewVolume" Width="80" Minimum="0" Maximum="1" Value=".8" ValueChanged="PreviewVolume_ValueChanged"/>
                                                        <Button x:Name="LoopButton" Content="↻ Loop" Click="Loop_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>
                    </xcad:LayoutPanel>
                    <xcad:LayoutAnchorablePane DockHeight="320" DockMinHeight="170">
                        <xcad:LayoutAnchorable Title="Layers" ContentId="layers" CanClose="False" CanHide="True" CanAutoHide="False">
                            <Grid Margin="4" PreviewMouseWheel="TimelineWorkspace_PreviewMouseWheel">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="KeyframeStripRow" Height="0" MinHeight="0"/>
                                    <RowDefinition x:Name="KeyframeSplitterRow" Height="0"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border x:Name="KeyframeStrip" CornerRadius="8" BorderBrush="#3F7A9A" BorderThickness="1" Background="#081326" Padding="8,6,8,8" ClipToBounds="True"/>
                                <GridSplitter x:Name="KeyframeStripSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#2F5972" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="Drag to resize the keyframe timeline"/>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="MarkerText" Text="PROJECT: 00:00.000" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="12" ToolTip="How long the finished video will be, worked out from the clips on the timeline"/>
                                        <TextBlock x:Name="CompositionStatus" Text="  •  LAYERS: 0" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11"/>
                                        <TextBlock x:Name="WorkAreaText" Text="  •  WORK: 00:00" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="11" Cursor="Hand" ToolTip="Click to set how far the timeline runs, which is the room you have to work in" MouseLeftButtonUp="WorkArea_MouseLeftButtonUp"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="CaretText" Text="00:00.000" Foreground="White" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Where the white edit caret is on the timeline"/>
                                        <Button Content="‹◆" Click="PreviousKeyframe_Click" Style="{StaticResource PillButton}" ToolTip="Move the white edit caret to the previous keyframe"/>
                                        <Button x:Name="KeyframeStripButton" Content="◇ Keyframes" Click="Keyframe_Click" Style="{StaticResource PillButton}" ToolTip="Show or hide the keyframe timeline above the layers"/>
                                        <Button Content="◆›" Click="NextKeyframe_Click" Style="{StaticResource PillButton}" ToolTip="Move the white edit caret to the next keyframe"/>
                                        <Button Content="✂ Split [C]" Click="SplitPlacement_Click" Style="{StaticResource PillButton}" ToolTip="Split the selected clip at the white edit caret"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="＋ Layer" Click="AddLayer_Click" Style="{StaticResource PillButton}"/>
                                        <Button Content="＋ Audio" Click="AddAudioLayer_Click" Style="{StaticResource PillButton}"/>
                                        <Button Content="＋ Graphic" Click="AddGraphic_Click" Style="{StaticResource PillButton}"/>
                                        <TextBlock x:Name="ZoomText" Text=" 100% • Ctrl+Wheel to zoom" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="3" CornerRadius="8" BorderBrush="#3F7A9A" BorderThickness="1" Background="#081326" ClipToBounds="True">
                                    <ScrollViewer x:Name="CompositionScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="TimelineWorkspace_PreviewMouseWheel" AllowDrop="True" DragOver="LayersArea_DragOver" Drop="LayersArea_Drop">
                                        <StackPanel x:Name="LayerStack" MinWidth="600"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </xcad:LayoutAnchorable>
                    </xcad:LayoutAnchorablePane>
                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>
        <Border Grid.Row="3" Background="#0A1426" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📸 Screenshot" Click="Snapshot_Click" ToolTip="Capture the current frame (P)"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙ Export Settings" Click="ExportSettings_Click"/>
                    <Button Content="Publish" Click="Publish_Click" Background="#1D5E52" Foreground="White" BorderBrush="#43C4AC" FontWeight="SemiBold" ToolTip="Render and upload to a connected account"/>
                    <Button Content="Export Audio" Click="ExportAudio_Click" Background="#5C439D" Foreground="White" BorderBrush="#AA8BE8" FontWeight="SemiBold"/>
                    <Button Content="Export Video" Style="{StaticResource AccentButton}" Click="Export_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="BusyOverlay" Grid.RowSpan="4" Background="#CC030711" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                <TextBlock x:Name="BusyText" Text="Working…" FontSize="22" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Height="8" Margin="0,18" Minimum="0" Maximum="1"/>
                <Button Content="Cancel" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
